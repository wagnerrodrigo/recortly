# API + worker + banco
SMASHCUT_DATABASE_URL=postgres://smashcut:smashcut@localhost:5433/smashcut?sslmode=disable
SMASHCUT_REDIS_ADDR=localhost:6380
SMASHCUT_ADDR=:8080
SMASHCUT_STORAGE_DIR=./storage
SMASHCUT_SESSION_TTL_HOURS=720
SMASHCUT_RENDER_CONCURRENCY=1

# Chave usada para assinar o state do OAuth. Troque em produção.
SMASHCUT_TOKEN_KEY=troque-esta-chave

# Usuários criados no primeiro boot: "email:senha:Nome|email:senha:Nome"
SMASHCUT_USERS=eu@smashcut.local:smashcut123:Eu|amigo@smashcut.local:smashcut123:Amigo

# YouTube (opcional na fase 3)
SMASHCUT_YOUTUBE_CLIENT_ID=
SMASHCUT_YOUTUBE_CLIENT_SECRET=
SMASHCUT_YOUTUBE_REDIRECT=http://localhost:3000/api/oauth/youtube/callback

# Front
NUXT_PUBLIC_API_BASE=http://localhost:8080
NUXT_API_PROXY_TARGET=http://localhost:8080

# IA local para gerar frases (LM Studio, Ollama ou qualquer API OpenAI-compatível)
# LM Studio: inicie o servidor local na porta 1234 e use o id exato do modelo
# Ollama:    SMASHCUT_AI_BASE_URL=http://localhost:11434/v1
SMASHCUT_AI_BASE_URL=http://localhost:1234/v1
SMASHCUT_AI_MODEL=gpt-oss-20b
SMASHCUT_AI_MAX_TOKENS=3000
# gpt-oss e similares gastam tokens "pensando". low ajuda a sobrar para a resposta.
SMASHCUT_AI_REASONING_EFFORT=low
