# API + worker + banco
RECORTLY_DATABASE_URL=postgres://recortly:recortly@localhost:5433/recortly?sslmode=disable
RECORTLY_REDIS_ADDR=localhost:6380
RECORTLY_ADDR=:8080
RECORTLY_STORAGE_DIR=./storage
RECORTLY_SESSION_TTL_HOURS=720
RECORTLY_RENDER_CONCURRENCY=1

# Chave usada para assinar o state do OAuth. Troque em produção.
RECORTLY_TOKEN_KEY=troque-esta-chave

# Usuários criados no primeiro boot: "email:senha:Nome|email:senha:Nome"
RECORTLY_USERS=eu@recortly.local:recortly123:Eu|amigo@recortly.local:recortly123:Amigo

# YouTube (opcional na fase 3)
RECORTLY_YOUTUBE_CLIENT_ID=
RECORTLY_YOUTUBE_CLIENT_SECRET=
RECORTLY_YOUTUBE_REDIRECT=http://localhost:3000/api/oauth/youtube/callback

# Front
NUXT_PUBLIC_API_BASE=http://localhost:8080
NUXT_API_PROXY_TARGET=http://localhost:8080

# IA local para gerar frases (LM Studio, Ollama ou qualquer API OpenAI-compatível)
# LM Studio: inicie o servidor local na porta 1234 e use o id exato do modelo
# Ollama:    RECORTLY_AI_BASE_URL=http://localhost:11434/v1
RECORTLY_AI_BASE_URL=http://localhost:1234/v1
RECORTLY_AI_MODEL=gpt-oss-20b
RECORTLY_AI_MAX_TOKENS=3000
# gpt-oss e similares gastam tokens "pensando". low ajuda a sobrar para a resposta.
RECORTLY_AI_REASONING_EFFORT=low
